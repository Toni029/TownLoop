{
  "status": "LOCAL_PROPOSAL_DO_NOT_APPLY",
  "project": "cc-livingcommunity-app",
  "region": "us-central1",
  "customRoles": {
    "townloopRegistrationApiAuth": {
      "title": "townloopRegistrationApiAuth",
      "stage": "GA",
      "includedPermissions": [
        "firebaseauth.users.get"
      ]
    },
    "townloopRegistrationWorkerAuth": {
      "title": "townloopRegistrationWorkerAuth",
      "stage": "GA",
      "includedPermissions": [
        "firebaseauth.users.get",
        "firebaseauth.users.update",
        "firebaseauth.users.delete"
      ]
    },
    "townloopLifecycleDatabaseWriter": {
      "title": "townloopLifecycleDatabaseWriter",
      "stage": "GA",
      "includedPermissions": [
        "datastore.databases.get",
        "datastore.entities.get",
        "datastore.entities.list",
        "datastore.entities.create",
        "datastore.entities.update",
        "datastore.entities.delete"
      ]
    },
    "townloopLifecycleDatabaseReader": {
      "title": "townloopLifecycleDatabaseReader",
      "stage": "GA",
      "includedPermissions": [
        "datastore.databases.get",
        "datastore.entities.get",
        "datastore.entities.list"
      ]
    },
    "townloopMediaConfigurationReader": {
      "title": "townloopMediaConfigurationReader",
      "stage": "GA",
      "includedPermissions": [
        "firebaserules.releases.get",
        "firebaserules.rulesets.get",
        "cloudfunctions.functions.get",
        "cloudfunctions.functions.list",
        "resourcemanager.projects.getIamPolicy"
      ]
    },
    "townloopMediaBucketReader": {
      "title": "townloopMediaBucketReader",
      "stage": "GA",
      "includedPermissions": [
        "storage.buckets.get",
        "storage.buckets.getIamPolicy",
        "storage.objects.list"
      ]
    },
    "townloopSocialObjectCleaner": {
      "title": "townloopSocialObjectCleaner",
      "stage": "GA",
      "includedPermissions": [
        "storage.objects.get",
        "storage.objects.delete"
      ]
    }
  },
  "serviceAccounts": [
    {
      "accountId": "townloop-registration-api",
      "email": "townloop-registration-api@cc-livingcommunity-app.iam.gserviceaccount.com",
      "bindings": [
        {
          "scope": "project",
          "role": "projects/cc-livingcommunity-app/roles/townloopRegistrationApiAuth"
        },
        {
          "scope": "project",
          "role": "projects/cc-livingcommunity-app/roles/townloopLifecycleDatabaseWriter",
          "condition": {
            "title": "default_database_only",
            "expression": "resource.name == \"projects/cc-livingcommunity-app/databases/(default)\""
          }
        },
        {
          "scope": "secret/TOWNLOOP_REGISTRATION_EMAIL_HMAC",
          "role": "roles/secretmanager.secretAccessor"
        }
      ]
    },
    {
      "accountId": "townloop-registration-cleanup",
      "email": "townloop-registration-cleanup@cc-livingcommunity-app.iam.gserviceaccount.com",
      "bindings": [
        {
          "scope": "project",
          "role": "projects/cc-livingcommunity-app/roles/townloopRegistrationWorkerAuth"
        },
        {
          "scope": "project",
          "role": "projects/cc-livingcommunity-app/roles/townloopLifecycleDatabaseWriter",
          "condition": {
            "title": "default_database_only",
            "expression": "resource.name == \"projects/cc-livingcommunity-app/databases/(default)\""
          }
        },
        {
          "scope": "secret/TOWNLOOP_REGISTRATION_EMAIL_HMAC",
          "role": "roles/secretmanager.secretAccessor"
        }
      ]
    },
    {
      "accountId": "townloop-social-media",
      "email": "townloop-social-media@cc-livingcommunity-app.iam.gserviceaccount.com",
      "bindings": [
        {
          "scope": "project",
          "role": "projects/cc-livingcommunity-app/roles/townloopLifecycleDatabaseWriter",
          "condition": {
            "title": "default_database_only",
            "expression": "resource.name == \"projects/cc-livingcommunity-app/databases/(default)\""
          }
        },
        {
          "scope": "project",
          "role": "projects/cc-livingcommunity-app/roles/townloopLifecycleDatabaseReader",
          "condition": {
            "title": "legacy_references_read_only",
            "expression": "resource.name == \"projects/cc-livingcommunity-app/databases/ai-studio-cclivingv27-5fc1a0f6-cd75-4964-8c9e-e219a265f7bb\""
          }
        },
        {
          "scope": "project",
          "role": "projects/cc-livingcommunity-app/roles/townloopMediaConfigurationReader"
        },
        {
          "scope": "bucket/cc-livingcommunity-app.firebasestorage.app",
          "role": "projects/cc-livingcommunity-app/roles/townloopMediaBucketReader"
        },
        {
          "scope": "bucket/cc-livingcommunity-app.firebasestorage.app",
          "role": "projects/cc-livingcommunity-app/roles/townloopSocialObjectCleaner",
          "condition": {
            "title": "only_social_objects",
            "expression": "resource.name.startsWith(\"projects/_/buckets/cc-livingcommunity-app.firebasestorage.app/objects/feed/\") || resource.name.startsWith(\"projects/_/buckets/cc-livingcommunity-app.firebasestorage.app/objects/marketplace/\")"
          }
        },
        {
          "scope": "project",
          "role": "roles/eventarc.eventReceiver"
        }
      ]
    }
  ],
  "secret": {
    "id": "TOWNLOOP_REGISTRATION_EMAIL_HMAC",
    "replication": {
      "automatic": {}
    },
    "initialKeyBytes": 32,
    "encoding": "base64",
    "generateOnlyAfterApproval": true,
    "automaticRotation": false,
    "versions": []
  },
  "indexesFile": "../firestore.indexes.json",
  "initialEnvironment": {
    "TOWNLOOP_REGISTRATION_API_ENABLED": "false",
    "TOWNLOOP_REGISTRATION_WORKER_ENABLED": "false",
    "TOWNLOOP_SOCIAL_MEDIA_QUEUE_ENABLED": "false",
    "TOWNLOOP_SOCIAL_MEDIA_WORKER_ENABLED": "false"
  },
  "schedules": [
    {
      "function": "processRegistrationLifecycle",
      "schedule": "every 60 minutes",
      "initialState": "PAUSED",
      "timeZone": "Etc/UTC",
      "invoker": "townloop-registration-cleanup@cc-livingcommunity-app.iam.gserviceaccount.com",
      "retryCount": 3
    },
    {
      "function": "resumeSocialMediaCleanup",
      "schedule": "every 15 minutes",
      "initialState": "PAUSED",
      "timeZone": "Etc/UTC",
      "invoker": "townloop-social-media@cc-livingcommunity-app.iam.gserviceaccount.com"
    },
    {
      "function": "inventorySocialMediaOrphans",
      "schedule": "every 60 minutes",
      "initialState": "PAUSED",
      "timeZone": "Etc/UTC",
      "invoker": "townloop-social-media@cc-livingcommunity-app.iam.gserviceaccount.com"
    }
  ],
  "invocationBindings": {
    "scheduler": "roles/run.invoker on each exact underlying target service; OIDC caller as above, exact target audience; preserve Scheduler service-agent role; do not grant project-wide invoker",
    "eventarc": "roles/run.invoker on the two queue trigger services for the configured Eventarc trigger identity; Eventarc receiver on project",
    "deployer": "existing deployment principal needs iam.serviceAccounts.actAs on these three identities; no new keys or broad Editor grants"
  },
  "cautions": [
    "IAM permissions are not collection-level authorization; backend checks remain mandatory.",
    "Database IAM conditions must be verified with impersonated allowed/denied probes after approved provisioning; emulators do not verify IAM.",
    "Auth update/delete permissions are project-level; registration API receives no Auth deletion permissions.",
    "Storage get permits bytes as well as metadata; constrained to social prefixes, not private Inbox paths.",
    "Storage list is bucket-level and cannot be represented as a prefix-only grant here.",
    "Functions may create schedules enabled initially; worker flags stay false before creation, then pause schedules and verify before any API flag change.",
    "No service can write IAM, rules, account-deletion flags or its policy receipt through these custom roles except general Firestore entity rights; dedicated code/export scope and policy controls must be reviewed."
  ]
}
