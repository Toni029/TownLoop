rules_version = '2';
// PROPOSAL ONLY. Requires the metadata/draft/link migration in STORAGE_REVIEW.md.
// Do not deploy against unchanged clients or unaudited legacy metadata.
service firebase.storage {
  match /b/{bucket}/o {
    function approved() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approved == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['resident', 'admin', 'vip', 'crew'];
    }
    function manager() {
      return approved() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vip'];
    }
    function staff() {
      return approved() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vip', 'crew'];
    }
    function bounded() {
      return request.resource.size > 0 && request.resource.size < 25 * 1024 * 1024;
    }
    function image() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif|avif|bmp|tiff)');
    }
    function media() {
      return image() || request.resource.contentType.matches('video/(mp4|webm|quicktime|3gpp|3gpp2|x-m4v|mpeg|ogg)');
    }
    function validLink(metadata, collectionName) {
      return metadata.keys().hasAll(['uploadedBy', 'recordId', 'collection', 'securityVersion']) &&
        metadata.securityVersion == '1' && metadata.collection == collectionName &&
        metadata.recordId.matches('[A-Za-z0-9_-]{1,128}');
    }
    function newUpload() {
      return approved() && bounded() && request.resource.metadata.uploadedBy == request.auth.uid;
    }
    function order(metadata) {
      return firestore.get(/databases/(default)/documents/work_orders/$(metadata.recordId)).data;
    }
    function orderAccess(metadata) {
      return approved() && validLink(metadata, 'work_orders') &&
        (staff() || order(metadata).userId == request.auth.uid);
    }
    function socialLink(metadata, folder) {
      return (folder == 'feed' &&
          (validLink(metadata, 'discussion_feed') || validLink(metadata, 'posts'))) ||
        (folder == 'marketplace' &&
          (validLink(metadata, 'marketplace_posts') || validLink(metadata, 'marketItems')));
    }
    function socialOwner(metadata) {
      let item = firestore.get(/databases/(default)/documents/$(metadata.collection)/$(metadata.recordId)).data;
      return item.get('userId', item.get('authorId', '')) == request.auth.uid;
    }

    match /work_orders/{fileName} {
      allow get: if orderAccess(resource.metadata);
      allow create: if newUpload() && image() && orderAccess(request.resource.metadata) &&
        order(request.resource.metadata).status != 'Done';
      // Never replace bytes or relabel ownership of an existing attachment.
      allow update: if false;
      // Crew cannot delete. Residents cannot remove completed-ticket attachments.
      // Admin/VIP may remove orphaned legacy attachments during reviewed cleanup.
      allow delete: if manager() || (approved() && validLink(resource.metadata, 'work_orders') &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'resident' &&
        order(resource.metadata).userId == request.auth.uid && order(resource.metadata).status != 'Done');
    }

    match /{folder}/{fileName} {
      allow get: if folder in ['feed', 'marketplace'] && approved();
      allow create: if folder in ['feed', 'marketplace'] && newUpload() && media() &&
        socialLink(request.resource.metadata, folder) && socialOwner(request.resource.metadata);
      allow update: if false;
      allow delete: if folder in ['feed', 'marketplace'] &&
        (manager() || (approved() && socialLink(resource.metadata, folder) && socialOwner(resource.metadata)));
    }

    match /newsletters/{editionId}/document.pdf {
      allow get: if approved();
      // Existing web uploader uses a display name in uploadedBy. Authorization
      // here intentionally comes from the authenticated profile, not that value.
      allow create, update: if manager() && bounded() && request.resource.contentType == 'application/pdf';
      allow delete: if manager();
    }

    // No client bucket listing; apps resolve attachments from authorized Firestore records.
    // Avatars currently live in Firestore. No speculative Storage avatar folders.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
