rules_version = '2';
// C2 compatibility candidate. Requires verified linkage and server-owned web policy.
// No deployment until unresolved historical references are reconciled.
service firebase.storage {
  match /b/{bucket}/o {
    function signed() {
      return request.auth != null && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous' &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') != '';
    }
    function approved() {
      return signed() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approved == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('deletionPending', false) == false &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['resident', 'admin', 'vip', 'crew'];
    }
    function manager() {
      return approved() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vip'];
    }
    function staff() {
      return approved() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vip', 'crew'];
    }
    // Server-only projection. Named database profiles never grant native-parent access.
    function webPolicy() {
      return firestore.get(/databases/(default)/documents/storage_web_authorization/policy).data;
    }
    function webRole() {
      let member = webPolicy().get('members', {}).get(request.auth.uid, {});
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? (approved() ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role : '')
        : (member.get('approved', false) == true ? member.get('role', '') : '');
    }
    function webApproved() {
      return signed() && webRole() in ['resident', 'admin', 'vip', 'crew'];
    }
    function legacyMetadata(metadata) {
      return !metadata.keys().hasAny(['securityVersion', 'recordId', 'collection']);
    }
    function webActive() {
      return webPolicy().get('legacyUploadsAfter', null) is timestamp &&
        request.time >= webPolicy().legacyUploadsAfter;
    }
    function legacyCreate(folder) {
      return resource == null && legacyMetadata(request.resource.metadata) && webApproved() && webActive() && bounded() &&
        request.resource.metadata.get('uploadedBy', '') == request.auth.uid &&
        request.resource.metadata.get('folder', '') == folder;
    }
    // Existing public-writable uploadedBy is NEVER treated as historical ownership.
    function legacyOwnRead() {
      return legacyMetadata(resource.metadata) && webApproved() && webActive() &&
        resource.timeCreated >= webPolicy().legacyUploadsAfter &&
        resource.metadata.get('uploadedBy', '') == request.auth.uid;
    }
    function bounded() {
      return request.resource.size > 0 && request.resource.size < 25 * 1024 * 1024;
    }
    function image() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif|avif|bmp|tiff)');
    }
    function media() {
      return image() || request.resource.contentType.matches('video/(mp4|webm|quicktime|3gpp|3gpp2|x-m4v|mpeg|ogg)');
    }
    function validLink(metadata, collectionName) {
      return metadata.keys().hasAll(['uploadedBy', 'recordId', 'collection', 'securityVersion']) &&
        metadata.securityVersion == '1' && metadata.collection == collectionName &&
        metadata.recordId.matches('[A-Za-z0-9_-]{1,128}');
    }
    function newUpload() {
      return approved() && bounded() && request.resource.metadata.uploadedBy == request.auth.uid;
    }
    function order(metadata) {
      return firestore.get(/databases/(default)/documents/work_orders/$(metadata.recordId)).data;
    }
    function liveUploadParent(item) {
      return item.get('storageDraft', true) == false ||
        (item.userId == request.auth.uid && item.storageDraftExpiresAt > request.time);
    }
    function orderAccess(metadata) {
      return approved() && validLink(metadata, 'work_orders') &&
        ((staff() && order(metadata).get('storageDraft', true) == false) || order(metadata).userId == request.auth.uid);
    }
    function socialLink(metadata, folder) {
      return (folder == 'feed' &&
          (validLink(metadata, 'discussion_feed') || validLink(metadata, 'posts'))) ||
        (folder == 'marketplace' &&
          (validLink(metadata, 'marketplace_posts') || validLink(metadata, 'marketItems')));
    }
    function socialOwner(metadata) {
      let item = firestore.get(/databases/(default)/documents/$(metadata.collection)/$(metadata.recordId)).data;
      return item.get('userId', item.get('authorId', '')) == request.auth.uid;
    }

    function socialRead(metadata) {
      let item = firestore.get(/databases/(default)/documents/$(metadata.collection)/$(metadata.recordId)).data;
      return item.get('storageDraft', true) == false || item.get('userId', item.get('authorId', '')) == request.auth.uid;
    }
    function socialUpload(metadata) {
      return liveUploadParent(firestore.get(/databases/(default)/documents/$(metadata.collection)/$(metadata.recordId)).data);
    }

    match /work_orders/{fileName} {
      allow get: if orderAccess(resource.metadata) || legacyOwnRead();
      allow create: if resource == null && newUpload() && image() && orderAccess(request.resource.metadata) &&
        order(request.resource.metadata).get('status', '') != 'Done' && liveUploadParent(order(request.resource.metadata)) ||
        (image() && legacyCreate('work_orders'));
      // Never replace bytes or relabel ownership of an existing attachment.
      allow update: if false;
      // Crew cannot delete. Residents cannot remove completed-ticket attachments.
      // Admin/VIP may remove orphaned legacy attachments during reviewed cleanup.
      allow delete: if manager() || (approved() && validLink(resource.metadata, 'work_orders') &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'resident' &&
        order(resource.metadata).userId == request.auth.uid && order(resource.metadata).get('status', '') != 'Done');
    }

    match /{folder}/{fileName} {
      allow get: if folder in ['feed', 'marketplace'] && approved() &&
        (resource.metadata.get('securityVersion', '') != '1' ||
          (socialLink(resource.metadata, folder) && socialRead(resource.metadata))) ||
        (folder in ['feed', 'marketplace'] && resource.metadata.get('securityVersion', '') != '1' && webApproved());
      allow create: if resource == null && folder in ['feed', 'marketplace'] && newUpload() && media() &&
        socialLink(request.resource.metadata, folder) && socialOwner(request.resource.metadata) &&
        socialUpload(request.resource.metadata) ||
        (folder in ['feed', 'marketplace'] && media() && legacyCreate(folder));
      allow update: if false;
      allow delete: if folder in ['feed', 'marketplace'] &&
        (manager() || (approved() && socialLink(resource.metadata, folder) && socialOwner(resource.metadata)));
    }

    match /newsletters/{editionId}/document.pdf {
      allow get: if approved() || webApproved();
      // Authorization comes from the authenticated profile; metadata is descriptive.
      allow create, update: if (manager() || (signed() && webRole() in ['admin', 'vip'])) && bounded() && request.resource.contentType == 'application/pdf';
      allow delete: if manager();
    }

    // No client bucket listing; apps resolve attachments from authorized Firestore records.
    // Avatars currently live in Firestore. No speculative Storage avatar folders.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
