rules_version = '2';
// LOCAL named-only candidate. Not compatible with the original hosted client.
// Historical authorizations/mailboxes require independent server review; none exist by inference.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null &&
        !exists(/databases/$(database)/documents/account_access_revocations/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn() && currentProfile().approved == true &&
        currentProfile().get('deletionPending', false) == false &&
        currentProfile().role in ['resident', 'admin', 'vip', 'crew'];
    }

    function isManager() {
      return isApproved() &&
        (currentProfile().role == 'admin' || currentProfile().role == 'vip');
    }

    function isCrewOrManager() {
      return isApproved() &&
        (currentProfile().role == 'crew' || isManager());
    }

    // Full profiles are private. Pending registrations can fetch only their own.
    match /users/{userId} {
      allow get: if isOwner(userId) || isManager();
      allow list: if isManager();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['id','name','email','role','approved','createdAt','address','phone','avatarUrl','avatar_url','termsVersion','termsAcceptedAt']) &&
        request.resource.data.id == request.auth.uid && request.resource.data.email == request.auth.token.email &&
        request.resource.data.name is string && request.resource.data.name.size() <= 300 &&
        request.resource.data.role in ['', 'resident'] && request.resource.data.approved == false &&
        (!request.resource.data.keys().hasAny(['termsVersion','termsAcceptedAt']) ||
          (request.resource.data.termsVersion == '2026-10-draft1' && request.resource.data.termsAcceptedAt == request.time));
      allow update: if !exists(/databases/$(database)/documents/account_access_revocations/$(userId)) &&
        resource.data.get('deletionPending', false) == false &&
        request.resource.data.get('id', '') == resource.data.get('id', '') &&
        request.resource.data.get('email', '') == resource.data.get('email', '') &&
        ((isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatarUrl','avatar_url'])) ||
         (isManager() && request.resource.data.role in ['resident','crew','admin','vip'] && request.resource.data.approved is bool &&
          (userId != request.auth.uid || request.resource.data.role == resource.data.role) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','role','approved','phone','address','wing','avatarUrl','avatar_url','dateOfBirth','date_of_birth','maritalStatus','marital_status','emergencyContactName','emergencyContactPhone','emergencyContactAddress','emergencyContact','emergency_contact','emergency_contact_phone','emergency_contact_address','dietaryPreference','dietary_preference','profileUpdateRequest'])));
      // Account deletion must use the existing reviewed server flow.
      allow delete: if false;
    }
    match /resident_directory/{uid} {
      allow get, list: if isApproved();
      allow write: if false;
    }

    // Existing named records were broadly writable. Their identity fields alone
    // are not evidence. Only a separately reviewed server-owned grant can authorize
    // existing private history; changed identities invalidate that grant.
    function attested(source, id, identity) {
      let grant = get(/databases/$(database)/documents/legacy_record_authorizations/$(source)/records/$(id)).data;
      return grant.status == 'verified' && grant.source == source && grant.recordId == id && grant.identity == identity;
    }
    function chatAttested(source, id, data) {
      return (source == 'resident_chats' && attested(source, id, {'participantIds': data.participantIds})) ||
        (source == 'marketplace_chats' && attested(source, id, {'sellerId': data.sellerId, 'buyerId': data.buyerId})) ||
        (source in ['office_chats','maintenance_chats'] && attested(source, id, {'residentId': data.residentId}));
    }
    function marketActive(data) {
      return data.sellerId != data.buyerId &&
        ((request.auth.uid == data.sellerId && !data.get('sellerLeft', false) && !data.get('deletedBySeller', false) && !data.get('deletedBy', []).hasAny(['seller'])) ||
         (request.auth.uid == data.buyerId && !data.get('buyerLeft', false) && !data.get('deletedByBuyer', false) && !data.get('deletedBy', []).hasAny(['buyer'])));
    }
    function chatAccess(source, id, data) {
      let grant = get(/databases/$(database)/documents/legacy_record_authorizations/$(source)/records/$(id)).data;
      return isApproved() && grant.epoch is string && grant.epoch.matches('^[A-Za-z0-9_-]{1,32}$') &&
        data.get('authorizationEpoch', '') == grant.epoch && chatAttested(source, id, data) &&
        grant.memberIds is list && grant.memberIds.hasAny([request.auth.uid]) &&
        data.get('leftBy', {}).get(request.auth.uid, false) != true && !('groupConversationId' in data) &&
        ((source == 'office_chats' && ((data.residentId == request.auth.uid && data.get('sideLeft',{}).get('resident',false) != true) || (data.residentId != request.auth.uid && currentProfile().role in ['admin','vip'] && data.get('sideLeft',{}).get('team',false) != true))) ||
         (source == 'maintenance_chats' && ((data.residentId == request.auth.uid && data.get('sideLeft',{}).get('resident',false) != true) || (data.residentId != request.auth.uid && currentProfile().role == 'crew' && data.get('sideLeft',{}).get('team',false) != true))) ||
         (source == 'resident_chats' && data.participantIds is list && data.participantIds.size() == 2 && data.participantIds[0] != data.participantIds[1] && data.participantIds.hasAny([request.auth.uid])) ||
         (source == 'marketplace_chats' && marketActive(data)));
    }
    function chatMayAppend(source, data) {
      return (source == 'resident_chats' &&
          data.get('leftBy',{}).get(data.participantIds[0],false) != true && data.get('leftBy',{}).get(data.participantIds[1],false) != true) ||
        (source in ['office_chats','maintenance_chats'] &&
          data.get('leftBy',{}).get(data.residentId,false) != true && data.get('sideLeft',{}).get('resident',false) != true && data.get('sideLeft',{}).get('team',false) != true) ||
        (source == 'marketplace_chats' &&
          !(data.get('sellerLeft',false) || data.get('buyerLeft',false) || data.get('deletedBySeller',false) || data.get('deletedByBuyer',false) || data.get('deletedBy',[]).hasAny(['seller','buyer'])));
    }
    function ownCursor(old, next, field) {
      let before = old.get(field, {});
      let after = next.get(field, {});
      return before is map && after is map && after.diff(before).affectedKeys().hasOnly([request.auth.uid]) &&
        (after == before || (after[request.auth.uid] is int && after[request.auth.uid] == next.messages.size()));
    }
    function canonicalAppend(source, id, old, next) {
      let grant = get(/databases/$(database)/documents/legacy_record_authorizations/$(source)/records/$(id)).data;
      let before = old.get('messages', []);
      let after = next.messages;
      let added = after[after.size() - 1];
      let text = added.get(source == 'marketplace_chats' ? 'text' : 'body', '');
      return before is list && after is list && after.size() == before.size() + 1 &&
        !before.hasAny([added]) && after.removeAll([added]) == before &&
        added.keys().hasOnly(['id','senderId','senderName','senderRole','senderAvatar','body','text','createdAt','time','timestamp','operationId']) &&
        added.id == 'legacy_' + grant.epoch + '_' + request.auth.uid + '_' + string(before.size()) &&
        grant.historicalMessageIds is list && grant.historyLength is int && before.size() >= grant.historyLength &&
        !grant.historicalMessageIds.hasAny([added.id]) && added.operationId is string && added.operationId.size() > 0 && added.operationId.size() <= 128 &&
        added.senderId == request.auth.uid && added.senderName == currentProfile().get('name','Resident') &&
        added.get('senderRole', currentProfile().role) == currentProfile().role &&
        added.get('senderAvatar','') == currentProfile().get('avatar_url',currentProfile().get('avatarUrl','')) &&
        text is string && text.size() > 0 && text.size() <= 10000 && text.matches('(?s).*[^\\s].*') &&
        added.createdAt is int && added.createdAt >= 0 && next.lastMessage == text && next.updatedAt == added.createdAt;
    }
    function chatUpdate(source, id) {
      let before = resource.data;
      let after = request.resource.data;
      let changes = after.diff(before).affectedKeys();
      return chatAccess(source, id, before) &&
        ownCursor(before, after, 'readBy') && ownCursor(before, after, 'hiddenBy') &&
        ((changes.hasOnly(['readBy','hiddenBy'])) ||
         (changes.hasOnly(['messages','lastMessage','updatedAt','subject','readBy']) &&
          canonicalAppend(source, id, before, after) &&
          chatMayAppend(source, before)));
    }
    match /legacy_record_authorizations/{source}/records/{id} { allow read, write: if false; }
    // Server-only content-free projection for listing authorized exact record IDs.
    match /legacy_private_mailboxes/{uid}/records/{id} {
      allow get, list: if isApproved() && request.auth.uid == uid;
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isApproved() && (isManager() || resource.data.authorId == request.auth.uid);
    }

    match /marketItems/{itemId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.authorId == request.auth.uid;
      allow update: if isApproved() && (isManager() || resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']));
      allow delete: if isApproved() && (isManager() || resource.data.authorId == request.auth.uid);
    }

    match /marketplace_posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isApproved() && (isManager() || resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'claimed']));
      allow delete: if isApproved() && (isManager() || resource.data.userId == request.auth.uid);
    }

    match /discussion_feed/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isApproved() && (isManager() || resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes']));
      allow delete: if isApproved() && (isManager() || resource.data.userId == request.auth.uid);
    }

    // A revision replaces only the original crew member's resolution, retaining prior text.
    function validResolutionRevision() {
      let i = resource.data.resolutionCommentIndex;
      let before = resource.data.comments[i];
      let after = request.resource.data.comments[i];
      return resource.data.resolutionAuthorId == request.auth.uid &&
        request.resource.data.resolutionAuthorId == resource.data.resolutionAuthorId &&
        request.resource.data.resolutionCommentId == resource.data.resolutionCommentId &&
        request.resource.data.resolutionCommentIndex == i &&
        before.id == resource.data.resolutionCommentId && after.id == before.id &&
        before.get('authorId', '') == request.auth.uid &&
        after.diff(before).affectedKeys().hasOnly(['text', 'photoUrl', 'editedAt', 'revisions']) &&
        after.text == request.resource.data.resolutionNote &&
        request.resource.data.comments.size() == resource.data.comments.size() &&
        request.resource.data.comments.removeAll([after]) == resource.data.comments.removeAll([before]) &&
        after.revisions == before.get('revisions', []).concat([{
          'text': before.text, 'photoUrl': before.get('photoUrl', ''),
          'timestamp': before.timestamp, 'editedAt': before.get('editedAt', '')
        }]);
    }
    function validNewResolution() {
      let before = resource.data.comments;
      let comments = request.resource.data.comments;
      let i = comments.size() - 1;
      let added = comments[i];
      return comments == before.concat([added]) && !before.hasAny([added]) &&
        added.id is string && added.id.size() > 0 && added.id.size() <= 200 &&
        added.authorId == request.auth.uid && added.author == currentProfile().name &&
        added.role == 'Maintenance Crew' && added.kind == 'resolution' &&
        added.text == request.resource.data.resolutionNote &&
        request.resource.data.resolutionCommentId == added.id && request.resource.data.resolutionCommentIndex == i &&
        request.resource.data.resolutionAuthorId == request.auth.uid;
    }
    function validReopenedResolution() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['resolutionCommentId', 'resolutionCommentIndex', 'resolutionAuthorId']) ||
        !data.keys().hasAny(['resolutionCommentId', 'resolutionCommentIndex', 'resolutionAuthorId']) ||
        (data.resolutionAuthorId == request.auth.uid && data.comments == resource.data.comments &&
         data.resolutionCommentIndex == resource.data.comments.size() - 1 &&
         data.comments[data.resolutionCommentIndex].id == data.resolutionCommentId &&
         data.comments[data.resolutionCommentIndex].get('authorId', '') == request.auth.uid &&
         data.comments[data.resolutionCommentIndex].author == currentProfile().name &&
         data.comments[data.resolutionCommentIndex].text == resource.data.resolutionNote &&
         resource.data.completedBy == currentProfile().name);
    }

    // Managers may remove exactly one resolution, with an append-only audit record.
    function validResolutionCommentDeletion() {
      let before = resource.data;
      let after = request.resource.data;
      let audit = after.resolutionCommentDeletions;
      let entry = audit[audit.size() - 1];
      let removed = entry.comment;
      let oldId = before.get('resolutionCommentId', '');
      let hasPointer = after.keys().hasAny(['resolutionCommentId', 'resolutionCommentIndex', 'resolutionAuthorId']);
      return isManager() &&
        after.diff(before).affectedKeys().hasOnly(['comments', 'resolutionCommentDeletions', 'lastResolutionCommentDeletedAt', 'updatedAt', 'resolutionCommentId', 'resolutionCommentIndex', 'resolutionAuthorId']) &&
        removed.role == 'Maintenance Crew' &&
        (removed.get('kind', '') == 'resolution' || removed.id == oldId ||
          (before.status == 'Done' && removed.text == before.get('resolutionNote', '') && removed.author == before.get('completedBy', ''))) &&
        before.comments.hasAny([removed]) && after.comments == before.comments.removeAll([removed]) &&
        after.comments.size() == before.comments.size() - 1 &&
        audit == before.get('resolutionCommentDeletions', []).concat([entry]) &&
        entry.keys().hasOnly(['comment', 'deletedBy', 'deletedAt']) && entry.deletedBy == request.auth.uid && entry.deletedAt is string &&
        after.lastResolutionCommentDeletedAt == request.time && after.updatedAt == request.time &&
        ((oldId == '' || removed.id == oldId) ? !hasPointer :
          (after.resolutionCommentId == oldId && after.resolutionAuthorId == before.resolutionAuthorId &&
           after.resolutionCommentIndex is int && after.resolutionCommentIndex >= 0 &&
           after.resolutionCommentIndex < after.comments.size() &&
           after.comments[after.resolutionCommentIndex] == before.comments[before.resolutionCommentIndex]));
    }

    function validWorkOrderTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let protected = ['status', 'completedAt', 'completedBy', 'retentionVersion', 'resolutionNote', 'resolutionCommentId', 'resolutionCommentIndex', 'resolutionAuthorId', 'comments', 'resolutionCommentDeletions', 'lastResolutionCommentDeletedAt'];
      return (!changed.hasAny(protected)) || (isManager() && validResolutionCommentDeletion()) ||
        (!changed.hasAny(['resolutionCommentDeletions', 'lastResolutionCommentDeletedAt']) && currentProfile().role == 'crew' && (
          (resource.data.status != 'Done' && request.resource.data.status in ['Queued', 'In Progress'] &&
            !changed.hasAny(['completedAt', 'completedBy', 'retentionVersion', 'resolutionNote', 'resolutionCommentId', 'resolutionCommentIndex', 'resolutionAuthorId']) &&
            (!changed.hasAny(['comments']) || (request.resource.data.comments.size() == resource.data.comments.size() + 1 &&
              request.resource.data.comments.removeAll([request.resource.data.comments[request.resource.data.comments.size() - 1]]) == resource.data.comments &&
              request.resource.data.comments[request.resource.data.comments.size() - 1].author == currentProfile().name &&
              request.resource.data.comments[request.resource.data.comments.size() - 1].authorId == request.auth.uid &&
              request.resource.data.comments[request.resource.data.comments.size() - 1].role == 'Maintenance Crew' &&
              request.resource.data.comments[request.resource.data.comments.size() - 1].text is string &&
              request.resource.data.comments[request.resource.data.comments.size() - 1].text.size() > 0 &&
              request.resource.data.comments[request.resource.data.comments.size() - 1].text.size() <= 10000))) ||
          (resource.data.status != 'Done' && request.resource.data.status == 'Done' &&
            request.resource.data.completedAt == request.time && request.resource.data.retentionVersion == 1 &&
            request.resource.data.completedBy == currentProfile().name &&
            request.resource.data.resolutionNote is string && request.resource.data.resolutionNote.size() <= 10000 && request.resource.data.resolutionNote.matches('(?s).*[^\\s].*') &&
            (validNewResolution() || validResolutionRevision())) ||
          (resource.data.status == 'Done' && request.resource.data.status == 'In Progress' &&
            !request.resource.data.keys().hasAny(['completedAt', 'completedBy', 'retentionVersion', 'resolutionNote']) && request.resource.data.comments == resource.data.comments && validReopenedResolution())
        ));
    }

    function orderAccess(id, data) {
      return isApproved() && attested('work_orders', id, {'userId': data.userId}) &&
        (request.auth.uid == data.userId || isCrewOrManager());
    }
    match /work_orders/{orderId} {
      allow get: if orderAccess(orderId, resource.data);
      // Whole queues/owner lists require a reviewed bounded mailbox adapter.
      allow list: if false;
      allow create, delete: if false;
      allow update: if orderAccess(orderId, resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','category','categoryEmoji','photoUrl','photos','status','statusNote','updatedAt','completedAt','completedBy','retentionVersion','resolutionNote','resolutionCommentId','resolutionCommentIndex','resolutionAuthorId','comments','resolutionCommentDeletions','lastResolutionCommentDeletedAt','latestResolutionPhoto']) &&
        validWorkOrderTransition();
    }

    match /newsletters/{newsletterId} {
      allow read: if isApproved();
      allow write: if isManager();

      match /chunks/{chunkId} {
        allow read: if isApproved();
        allow write: if isManager();
      }
    }

    match /community_events/{eventId} {
      allow read: if isApproved();
      allow write: if isManager();
    }

    match /community_highlights/{highlightId} {
      allow read: if isApproved();
      allow write: if isManager();
    }

    match /maintenance_chats/{chatId} {
      allow get: if chatAccess('maintenance_chats', chatId, resource.data);
      allow list, create, delete: if false;
      allow update: if chatUpdate('maintenance_chats', chatId);
    }

    match /office_chats/{chatId} {
      allow get: if chatAccess('office_chats', chatId, resource.data);
      allow list, create, delete: if false;
      allow update: if chatUpdate('office_chats', chatId);
    }

    match /resident_chats/{chatId} {
      allow get: if chatAccess('resident_chats', chatId, resource.data);
      allow list, create, delete: if false;
      allow update: if chatUpdate('resident_chats', chatId);
    }

    match /marketplace_chats/{chatId} {
      allow get: if chatAccess('marketplace_chats', chatId, resource.data);
      allow list, create, delete: if false;
      allow update: if chatUpdate('marketplace_chats', chatId);
    }

    // Server-managed deletion fence: clients cannot create, clear or inspect it.
    match /account_access_revocations/{uid} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
