{
  "expo": {
    "name": "TownLoop",
    "slug": "townloop-native",
    "version": "0.1.0",
    "scheme": "townloop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toni029.townloop",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.toni029.townloop",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "TownLoop uses selected photos and videos for your maintenance requests and community posts.",
          "cameraPermission": "TownLoop uses the camera to attach pictures to maintenance requests and community posts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "inbox",
          "color": "#059669"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#f7f3ea",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/9f970d26-beed-44d6-a590-9dcdc00e85de"
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "dark",
        "hidden": false
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "9f970d26-beed-44d6-a590-9dcdc00e85de"
      }
    },
    "owner": "seeds4clix"
  }
}
