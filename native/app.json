{
  "expo": {
    "name": "TownLoop",
    "slug": "townloop-native",
    "version": "0.1.0",
    "scheme": "townloop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toni029.townloop",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.toni029.townloop",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#42c7f1"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "TownLoop uses selected photos and videos for your maintenance requests and community posts.",
          "cameraPermission": "TownLoop uses the camera to attach pictures to maintenance requests and community posts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3ebdc",
          "image": "./assets/startup/native-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": false
        }
      ],
      "./plugins/withLocalDataProtection.cjs",
      "./plugins/with-google-auth.cjs",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#059669",
          "defaultChannel": "inbox",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/with-inbox-push.cjs"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#f3ebdc",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/9f970d26-beed-44d6-a590-9dcdc00e85de"
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "dark",
        "hidden": false
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "9f970d26-beed-44d6-a590-9dcdc00e85de"
      }
    },
    "owner": "seeds4clix"
  }
}
