rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn() && currentProfile().approved != false;
    }

    function isManager() {
      return isApproved() &&
        (currentProfile().role == 'admin' || currentProfile().role == 'vip');
    }

    function isCrewOrManager() {
      return isApproved() &&
        (currentProfile().role == 'crew' || isManager());
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'resident' &&
        request.resource.data.approved == false;
      allow update: if isManager() ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'address', 'avatarUrl', 'avatar_url', 'phone', 'wing',
                    'emergencyContact', 'emergency_contact', 'dietaryPreference',
                    'dietary_preference']));
      allow delete: if isManager();
    }

    match /posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isManager() || resource.data.authorId == request.auth.uid;
    }

    match /marketItems/{itemId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.authorId == request.auth.uid;
      allow update: if isManager() || resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
      allow delete: if isManager() || resource.data.authorId == request.auth.uid;
    }

    match /marketplace_posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isManager() || resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'claimed']);
      allow delete: if isManager() || resource.data.userId == request.auth.uid;
    }

    match /discussion_feed/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isManager() || resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes']);
      allow delete: if isManager() || resource.data.userId == request.auth.uid;
    }

    // Counter updates must be paired atomically with the submitting resident's new ticket.
    match /counters/work_orders {
      allow read: if isApproved();
      function validCounterTicket() {
        return isApproved() &&
        request.resource.data.keys().hasOnly(['lastNumber', 'orderId']) &&
        request.resource.data.lastNumber is int &&
        request.resource.data.orderId is string &&
        !exists(/databases/$(database)/documents/work_orders/$(request.resource.data.orderId)) &&
        getAfter(/databases/$(database)/documents/work_orders/$(request.resource.data.orderId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/work_orders/$(request.resource.data.orderId)).data.ticketNumber == request.resource.data.lastNumber;
      }
      allow create: if validCounterTicket() && request.resource.data.lastNumber == 10000;
      allow update: if validCounterTicket() && request.resource.data.lastNumber == resource.data.lastNumber + 1;
    }

    match /work_orders/{orderId} {
      allow get: if isApproved() && (!exists(/databases/$(database)/documents/work_orders/$(orderId)) || isCrewOrManager() || resource.data.userId == request.auth.uid);
      allow list: if isApproved() && (isCrewOrManager() || resource.data.userId == request.auth.uid);
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isApproved() && (isCrewOrManager() || resource.data.userId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'code', 'ticketNumber']);
      allow delete: if isManager() ||
        (resource.data.userId == request.auth.uid && resource.data.status != 'Done') ||
        (currentProfile().role == 'crew' && resource.data.status == 'Done');
    }

    match /newsletters/{newsletterId} {
      allow read: if isSignedIn();
      allow write: if isManager();

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow write: if isManager();
      }
    }

    // A resident can change only their own RSVP, never the event or another attendee.
    function ownRsvp() {
      let old = resource.data;
      let next = request.resource.data;
      let uid = request.auth.uid;
      let change = next.rsvpChange;
      let attendee = change.attendee;
      let before = old.get('attendees', []);
      let after = next.attendees;
      let members = old.get('rsvpMembers', {});
      let joining = change.going;
      return next.diff(old).affectedKeys().hasOnly([
          'attendees', 'attendeesCount', 'spotsLeft', 'updatedAt', 'rsvpMembers', 'rsvpChange'
        ]) && attendee.id == uid && attendee.get('userId', uid) == uid &&
        next.rsvpMembers.diff(members).affectedKeys().hasOnly([uid]) &&
        next.rsvpMembers[uid] == joining &&
        next.attendeesCount == after.size() &&
        (joining
          ? (members.get(uid, false) == false &&
             attendee.name == currentProfile().name &&
             attendee.email == currentProfile().email &&
             attendee.role == currentProfile().role &&
             after == [attendee].concat(before) &&
             (!(old.get('spotsLeft', null) is number) || old.spotsLeft > 0))
          : (before.hasAny([attendee]) && after == before.removeAll([attendee]) &&
             after.size() == before.size() - 1)) &&
        (old.get('spotsLeft', null) is number
          ? next.spotsLeft == old.spotsLeft + (joining ? -1 : 1)
          : next.get('spotsLeft', null) == old.get('spotsLeft', null));
    }
    match /community_events/{eventId} {
      allow read: if isApproved();
      allow create, delete: if isManager();
      allow update: if isManager() || (isApproved() && ownRsvp());
    }

    match /community_highlights/{highlightId} {
      allow read: if isApproved();
      allow write: if isManager();
    }

    match /maintenance_chats/{chatId} {
      allow read, write: if true;
    }

    match /office_chats/{chatId} {
      allow read, write: if true;
    }

    match /resident_chats/{chatId} {
      allow read, write: if true;
    }

    match /marketplace_chats/{chatId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
