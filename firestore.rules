rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn() && currentProfile().approved != false;
    }

    function isManager() {
      return isApproved() &&
        (currentProfile().role == 'admin' || currentProfile().role == 'vip');
    }

    function isCrewOrManager() {
      return isApproved() &&
        (currentProfile().role == 'crew' || isManager());
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'resident' &&
        request.resource.data.approved == false;
      allow update: if isManager() ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'address', 'avatarUrl', 'avatar_url', 'phone', 'wing',
                    'emergencyContact', 'emergency_contact', 'dietaryPreference',
                    'dietary_preference']));
      allow delete: if isManager();
    }

    match /posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isManager() || resource.data.authorId == request.auth.uid;
    }

    match /marketItems/{itemId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.authorId == request.auth.uid;
      allow update: if isManager() || resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
      allow delete: if isManager() || resource.data.authorId == request.auth.uid;
    }

    match /marketplace_posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isManager() || resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'claimed']);
      allow delete: if isManager() || resource.data.userId == request.auth.uid;
    }

    match /discussion_feed/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if isManager() || resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes']);
      allow delete: if isManager() || resource.data.userId == request.auth.uid;
    }

    // Counter updates must be paired atomically with the submitting resident's new ticket.
    match /counters/work_orders {
      allow read: if isApproved();
      function validCounterTicket() {
        return isApproved() &&
        request.resource.data.keys().hasOnly(['lastNumber', 'orderId']) &&
        request.resource.data.lastNumber is int &&
        request.resource.data.orderId is string &&
        !exists(/databases/$(database)/documents/work_orders/$(request.resource.data.orderId)) &&
        getAfter(/databases/$(database)/documents/work_orders/$(request.resource.data.orderId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/work_orders/$(request.resource.data.orderId)).data.ticketNumber == request.resource.data.lastNumber;
      }
      allow create: if validCounterTicket() && request.resource.data.lastNumber == 10000;
      allow update: if validCounterTicket() && request.resource.data.lastNumber == resource.data.lastNumber + 1;
    }

    // Four-digit allocator: initialized only by the audited administrative migration.
    function fourDigitTicket(orderId, number) {
      let ticket = getAfter(/databases/$(database)/documents/work_orders/$(orderId)).data;
      return !exists(/databases/$(database)/documents/work_orders/$(orderId)) &&
        ticket.userId == request.auth.uid && ticket.ticketNumber == number && ticket.code == string(number);
    }
    match /counters/work_orders_four_digit {
      allow read: if isApproved();
      allow update: if isApproved() && resource.data.ready == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastNumber', 'orderId']) &&
        request.resource.data.lastNumber == resource.data.lastNumber + 1 &&
        request.resource.data.lastNumber >= 1000 && request.resource.data.lastNumber <= 9999 &&
        ((request.resource.data.orderId == '' &&
          exists(/databases/$(database)/documents/work_order_numbers/$(string(request.resource.data.lastNumber)))) ||
         (request.resource.data.orderId is string && request.resource.data.orderId != '' &&
          !exists(/databases/$(database)/documents/work_order_numbers/$(string(request.resource.data.lastNumber))) &&
          getAfter(/databases/$(database)/documents/work_order_numbers/$(string(request.resource.data.lastNumber))).data.orderId == request.resource.data.orderId &&
          fourDigitTicket(request.resource.data.orderId, request.resource.data.lastNumber)));
    }
    match /work_order_numbers/{number} {
      allow read: if isApproved();
      allow create: if isApproved() && number.matches('^[1-9][0-9]{3}$') &&
        request.resource.data.keys().hasOnly(['orderId']) && request.resource.data.orderId is string &&
        getAfter(/databases/$(database)/documents/counters/work_orders_four_digit).data.orderId == request.resource.data.orderId &&
        string(getAfter(/databases/$(database)/documents/counters/work_orders_four_digit).data.lastNumber) == number &&
        fourDigitTicket(request.resource.data.orderId, getAfter(/databases/$(database)/documents/counters/work_orders_four_digit).data.lastNumber);
      // Reservations are permanent, even after a ticket is removed.
    }
    function allocatedTicket(orderId) {
      let number = request.resource.data.ticketNumber;
      return number is int &&
        ((number >= 1000 && number <= 9999 && request.resource.data.code == string(number) &&
          getAfter(/databases/$(database)/documents/counters/work_orders_four_digit).data.orderId == orderId &&
          getAfter(/databases/$(database)/documents/counters/work_orders_four_digit).data.lastNumber == number &&
          !exists(/databases/$(database)/documents/work_order_numbers/$(string(number))) &&
          getAfter(/databases/$(database)/documents/work_order_numbers/$(string(number))).data.orderId == orderId) ||
         (number >= 10000 && request.resource.data.code == 'WO-' + string(number) &&
          getAfter(/databases/$(database)/documents/counters/work_orders).data.orderId == orderId &&
          getAfter(/databases/$(database)/documents/counters/work_orders).data.lastNumber == number));
    }

    function validWorkOrderTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let protected = ['status', 'completedAt', 'completedBy', 'retentionVersion', 'resolutionNote'];
      return (!changed.hasAny(protected)) ||
        (currentProfile().role == 'crew' && (
          (resource.data.status != 'Done' && request.resource.data.status in ['Queued', 'In Progress'] &&
            !changed.hasAny(['completedAt', 'completedBy', 'retentionVersion', 'resolutionNote'])) ||
          (resource.data.status != 'Done' && request.resource.data.status == 'Done' &&
            request.resource.data.completedAt == request.time && request.resource.data.retentionVersion == 1 &&
            request.resource.data.completedBy == currentProfile().name &&
            request.resource.data.resolutionNote is string && request.resource.data.resolutionNote.matches('.*[^\\s].*') &&
            request.resource.data.comments.size() == resource.data.comments.size() + 1 &&
            request.resource.data.comments[request.resource.data.comments.size() - 1].text == request.resource.data.resolutionNote) ||
          (resource.data.status == 'Done' && request.resource.data.status == 'In Progress' &&
            !request.resource.data.keys().hasAny(['completedAt', 'completedBy', 'retentionVersion', 'resolutionNote']))
        ));
    }

    match /work_orders/{orderId} {
      allow get: if isApproved() && (!exists(/databases/$(database)/documents/work_orders/$(orderId)) || isCrewOrManager() || resource.data.userId == request.auth.uid);
      allow list: if isApproved() && (isCrewOrManager() || resource.data.userId == request.auth.uid);
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid && allocatedTicket(orderId) &&
        request.resource.data.status == 'Queued' &&
        !request.resource.data.keys().hasAny(['completedAt', 'completedBy', 'retentionVersion', 'resolutionNote']);
      allow update: if isApproved() && (isCrewOrManager() || resource.data.userId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'code', 'ticketNumber']) &&
        validWorkOrderTransition();
      allow delete: if isApproved() && (isManager() ||
        (currentProfile().role == 'resident' && resource.data.userId == request.auth.uid && resource.data.status != 'Done'));

    }

    match /newsletters/{newsletterId} {
      allow read: if isSignedIn();
      allow write: if isManager();

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow write: if isManager();
      }
    }

    // A resident can change only their own RSVP, never the event or another attendee.
    function ownRsvp() {
      let old = resource.data;
      let next = request.resource.data;
      let uid = request.auth.uid;
      let change = next.rsvpChange;
      let attendee = change.attendee;
      let before = old.get('attendees', []);
      let after = next.attendees;
      let members = old.get('rsvpMembers', {});
      let joining = change.going;
      return next.diff(old).affectedKeys().hasOnly([
          'attendees', 'attendeesCount', 'spotsLeft', 'updatedAt', 'rsvpMembers', 'rsvpChange'
        ]) && attendee.id == uid && attendee.get('userId', uid) == uid &&
        next.rsvpMembers.diff(members).affectedKeys().hasOnly([uid]) &&
        next.rsvpMembers[uid] == joining &&
        next.attendeesCount == after.size() &&
        (joining
          ? (members.get(uid, false) == false &&
             attendee.name == currentProfile().name &&
             attendee.email == currentProfile().email &&
             attendee.role == currentProfile().role &&
             after == [attendee].concat(before) &&
             (!(old.get('spotsLeft', null) is number) || old.spotsLeft > 0))
          : (before.hasAny([attendee]) && after == before.removeAll([attendee]) &&
             after.size() == before.size() - 1)) &&
        (old.get('spotsLeft', null) is number
          ? next.spotsLeft == old.spotsLeft + (joining ? -1 : 1)
          : next.get('spotsLeft', null) == old.get('spotsLeft', null));
    }
    match /community_events/{eventId} {
      allow read: if isApproved();
      allow create, delete: if isManager();
      allow update: if isManager() || (isApproved() && ownRsvp());
    }

    match /community_highlights/{highlightId} {
      allow read: if isApproved();
      allow write: if isManager();
    }

    // Push tokens and delivery claims are accessible only to authenticated server code.
    match /notification_devices/{deviceId} { allow read, write: if false; }
    match /notification_deliveries/{deliveryId} { allow read, write: if false; }
    function chatIdentities() {
      let email = request.auth.token.get('email', '').lower();
      let uid = request.auth.uid.lower();
      return [uid, uid.replace('[^a-zA-Z0-9_-]', '_'), email,
        email.replace('[^a-zA-Z0-9_-]', '_')];
    }
    function chatResident(data) {
      return data.get('residentId', '') == request.auth.uid ||
        (request.auth.token.get('email', '') != '' &&
         data.get('residentEmail', '').lower() == request.auth.token.email.lower());
    }
    function chatAccess(kind, data) {
      return isApproved() && (kind == 'friend'
        ? data.get('participantIds', []).hasAny(chatIdentities())
        : (chatResident(data) || (kind == 'office' ? isManager() : currentProfile().role == 'crew')));
    }
    function validAppend(before, after) {
      let last = after[after.size() - 1];
      return after.size() == before.size() + 1 &&
        after.removeAll([last]) == before &&
        last.id is string && last.id.size() > 0 &&
        last.body is string && last.body.size() > 0 && last.body.size() <= 10000 &&
        last.senderId.lower() in chatIdentities();
    }
    function chatUpdate(kind) {
      let old = resource.data;
      let next = request.resource.data;
      let before = old.get('messages', []);
      let after = next.get('messages', []);
      return chatAccess(kind, old) && chatAccess(kind, next) &&
        next.get('residentId', '') == old.get('residentId', '') &&
        next.get('residentEmail', '') == old.get('residentEmail', '') &&
        next.get('participants', []) == old.get('participants', []) &&
        next.get('participantIds', []) == old.get('participantIds', []) &&
        (validAppend(before, after) ||
          (after.size() == before.size() &&
           next.diff(old).affectedKeys().hasOnly(['messages', 'unreadBy', 'unreadByResident', 'unreadByVip', 'unreadByCrew'])));
    }
    match /maintenance_chats/{chatId} {
      allow get: if isApproved() && (chatId == request.auth.token.get('email', request.auth.uid).lower().replace('[^a-zA-Z0-9_-]', '_') || chatAccess('maintenance', resource.data));
      allow list: if chatAccess('maintenance', resource.data);
      allow create: if chatAccess('maintenance', request.resource.data) && validAppend([], request.resource.data.messages);
      allow update: if chatUpdate('maintenance');
      allow delete: if chatAccess('maintenance', resource.data);
    }
    match /office_chats/{chatId} {
      allow get: if isApproved() && (chatId == request.auth.token.get('email', request.auth.uid).lower().replace('[^a-zA-Z0-9_-]', '_') || chatAccess('office', resource.data));
      allow list: if chatAccess('office', resource.data);
      allow create: if chatAccess('office', request.resource.data) && validAppend([], request.resource.data.messages);
      allow update: if chatUpdate('office');
      allow delete: if chatAccess('office', resource.data);
    }
    match /resident_chats/{chatId} {
      allow get: if isApproved() && (!exists(/databases/$(database)/documents/resident_chats/$(chatId)) || chatAccess('friend', resource.data));
      allow list: if chatAccess('friend', resource.data);
      allow create: if chatAccess('friend', request.resource.data) && validAppend([], request.resource.data.messages);
      allow update: if chatUpdate('friend');
      allow delete: if chatAccess('friend', resource.data);
    }

    match /marketplace_chats/{chatId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
